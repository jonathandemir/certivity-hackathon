#!/usr/bin/env bash
# Einmalige Einrichtung eines Rechners. Idempotent, kann jederzeit erneut laufen.
#
#   scripts/setup <vorname> [--no-pdfs]
#
# 1. prüft git user.name / user.email
# 2. legt den persönlichen Branch <vorname> an (von origin/main) bzw. wechselt auf ihn und pusht ihn
# 3. legt den main-Worktree .worktrees/main an (für geteilte Dateien)
# 4. holt das Teilnehmerpaket nach vendor/industrial-ai-hackathon (gitignored, darf nicht ins Repo)
#    und lädt die Regulierungs-PDFs (~220 MB, Links laufen nach dem Event ab)
# 5. legt im Oberordner eine CLAUDE.md an, die auf dieses Repo verweist (nur wenn dort noch keine liegt)
. "$(dirname "$0")/lib.sh"

PKG_URL="${CERTIVITY_PKG_URL:-https://github.com/Certivity/industrial-ai-hackathon.git}"
PKG_DIR="$REPO_ROOT/vendor/industrial-ai-hackathon"

name=""; pdfs=1
for a in "$@"; do
  case "$a" in
    --no-pdfs) pdfs=0 ;;
    -*) die "Unbekannte Option $a" ;;
    *) name=$a ;;
  esac
done
[ -n "$name" ] || die "Nutzung: scripts/setup <vorname> [--no-pdfs]   (Vorname klein, wird dein Branch)"
printf '%s' "$name" | grep -qE '^[a-z][a-z0-9-]*$' || die "Branchname nur klein: a-z, 0-9, - (z. B. jonathan)."
[ "$name" = main ] && die "main ist kein persönlicher Branch."

# 1. Identität
[ -n "$(git config user.name)" ]  || die "git config --global user.name \"Vorname Nachname\" fehlt."
[ -n "$(git config user.email)" ] || die "git config --global user.email \"du@example.com\" fehlt."
ok "Git-Identität: $(me) <$(git config user.email)> auf $(host)"

# 2. Persönlicher Branch
fetch_origin 60 || die "git fetch fehlgeschlagen. Zugriff auf das GitHub-Repo vorhanden?"
cur=$(current_branch || echo "")
if [ "$cur" != "$name" ]; then
  [ -z "$(dirty_tracked)" ] || die "Uncommittete Änderungen in $cur. Erst committen, dann setup erneut."
  if has_ref "refs/heads/$name"; then
    git switch --quiet "$name"
  elif has_ref "refs/remotes/origin/$name"; then
    git switch --quiet --track -c "$name" "origin/$name"
  else
    git switch --quiet -c "$name" origin/main
  fi
fi
"$REPO_ROOT/scripts/sync" || die "sync fehlgeschlagen (siehe oben)."
ok "Branch $name ist ausgecheckt und gepusht."

# 3. main-Worktree
MAIN=$("$REPO_ROOT/scripts/main-wt") || die "main-Worktree fehlgeschlagen."
ok "main-Worktree: $MAIN"

# 4. Teilnehmerpaket + PDFs
mkdir -p "$REPO_ROOT/vendor"
if [ -d "$PKG_DIR/.git" ]; then
  git -C "$PKG_DIR" pull --quiet --ff-only || warn "Paket konnte nicht aktualisiert werden ($PKG_DIR)."
else
  git clone --quiet "$PKG_URL" "$PKG_DIR" || die "Klonen von $PKG_URL fehlgeschlagen."
fi
ok "Teilnehmerpaket: $PKG_DIR @ $(git -C "$PKG_DIR" rev-parse --short HEAD)"
if command -v python3 >/dev/null 2>&1; then
  python3 -c 'import jsonschema' 2>/dev/null || warn "Python-Paket jsonschema fehlt (für validate.py): python3 -m pip install --user jsonschema"
  if [ "$pdfs" -eq 1 ]; then
    note "Lade Regulierungs-PDFs (~220 MB) ..."
    if ! (cd "$PKG_DIR" && python3 tools/fetch_regulations.py); then
      # macOS + python.org-Python hat keine CA-Zertifikate (CERTIFICATE_VERIFY_FAILED).
      # Dann das certifi-Bündel nur für diesen Aufruf nutzen, ohne Systemänderung.
      ca=$(python3 -m certifi 2>/dev/null || true)
      if [ -z "${SSL_CERT_FILE:-}" ] && [ -n "$ca" ]; then
        note "Erneuter Versuch mit den certifi-Zertifikaten (SSL_CERT_FILE=$ca) ..."
        (cd "$PKG_DIR" && SSL_CERT_FILE="$ca" python3 tools/fetch_regulations.py) \
          || warn "PDF-Download unvollständig, auch mit certifi. Siehe vendor/industrial-ai-hackathon/README.md §1, dann scripts/setup $name erneut."
      else
        warn "PDF-Download unvollständig. Bei CERTIFICATE_VERIFY_FAILED: python3 -m pip install --user certifi oder vendor/industrial-ai-hackathon/README.md §1, dann scripts/setup $name erneut."
      fi
    fi
  fi
else
  warn "python3 fehlt. validate.py und fetch_regulations.py brauchen Python 3."
fi

# 5. CLAUDE.md im Oberordner
PARENT=$(dirname "$REPO_ROOT"); REPO_NAME=$(basename "$REPO_ROOT")
if [ ! -e "$PARENT/CLAUDE.md" ]; then
  cat > "$PARENT/CLAUDE.md" <<EOF
# Hinweis für Sessions in diesem Ordner

Diese Datei gilt nur für das Certivity-Hackathon-Repo \`./$REPO_NAME/\`. Geht es um ein anderes Projekt in diesem Ordner, ignoriere sie.

Geht es um Certivity / den Hackathon: arbeite in \`$REPO_NAME/\` und folge \`$REPO_NAME/AGENTS.md\`.
Die Hooks des Repos (Sessionstart, Stop-Check) feuern nicht, wenn die Session hier im Oberordner gestartet wurde. Darum selbst:
- zu Beginn: \`$REPO_NAME/scripts/session-start\` ausführen, \`$REPO_NAME/AGENTS.md\` und \`$REPO_NAME/docs/CONTEXT.md\` lesen
- vor dem Aufhören: \`$REPO_NAME/scripts/stop-check\`
Besser: die Session direkt in \`$REPO_NAME/\` starten.
EOF
  ok "Oberordner-CLAUDE.md angelegt: $PARENT/CLAUDE.md"
elif ! grep -q "$REPO_NAME/AGENTS.md" "$PARENT/CLAUDE.md"; then
  warn "$PARENT/CLAUDE.md existiert schon und verweist nicht auf dieses Repo. Bitte selbst ergänzen:"
  note "    Geht es um Certivity: arbeite in $REPO_NAME/, folge $REPO_NAME/AGENTS.md, starte mit $REPO_NAME/scripts/session-start."
fi

note ""
ok "Fertig. Claude Code jetzt direkt in $REPO_ROOT starten; der SessionStart-Hook zeigt STATUS und LOG."
