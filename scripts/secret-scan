#!/usr/bin/env bash
# Sucht nach Schlüsseln, Tokens und Geheimnis-Dateien.
#
#   scripts/secret-scan                 prüft alle Commits, die noch auf keinem origin-Branch sind
#                                       (genau das, was scripts/sync pushen würde)
#   scripts/secret-scan <datei> ...     prüft Dateien, z. B. Transkripte oder Logs vor dem git add
#
# Exit 0 = nichts gefunden, 1 = Fund (Treffer werden gekürzt ausgegeben, nie vollständig).
. "$(dirname "$0")/lib.sh"

# Konkrete Token-Formate (Groß-/Kleinschreibung zählt).
TOKENS='(^|[^A-Za-z0-9])sk-ant-[A-Za-z0-9_-]{20,}|(^|[^A-Za-z0-9])sk-(proj-)?[A-Za-z0-9_-]{32,}|AKIA[0-9A-Z]{16}|gh[pousr]_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{40,}|xox[abprs]-[A-Za-z0-9-]{10,}|AIza[0-9A-Za-z_-]{35}|hf_[A-Za-z0-9]{30,}|-----BEGIN [A-Z ]*PRIVATE KEY-----'
# Zuweisungen wie api_key = "...." (ohne Groß-/Kleinschreibung).
ASSIGN='(api[_-]?key|secret|token|passwor[dt])["'\'']?[[:space:]]*[:=][[:space:]]*["'\''][^"'\''[:space:]]{12,}["'\'']'
# Dateinamen, die nie in git gehören.
BADNAMES='(^|/)\.env($|\.)|\.pem$|\.p12$|\.pfx$|(^|/)id_(rsa|ed25519|ecdsa)$|(^|/)credentials\.json$'
BADNAMES_OK='(^|/)\.env\.(example|sample|template)$'

mask() { sed -E 's/(.{10}).*/\1…/'; }
found=0

scan_stream() { # label < "datei<TAB>zeile"-Strom; Rückgabe 1 bei Treffer
  local label=$1 data hits
  data=$(cat)
  hits=$( { printf '%s\n' "$data" | grep -E "$TOKENS"; printf '%s\n' "$data" | grep -iE "$ASSIGN"; } || true )
  [ -z "$hits" ] && return 0
  printf '%sGEHEIMNIS?%s %s\n' "$C_RED" "$C_OFF" "$label" >&2
  printf '%s\n' "$hits" | sort -u | while IFS=$'\t' read -r f line; do
    m=$( { printf '%s' "$line" | grep -oE "$TOKENS" ; printf '%s' "$line" | grep -oiE "$ASSIGN"; } 2>/dev/null | head -n 1 | sed -E 's/^[^A-Za-z0-9-]//' | mask)
    printf '    %s: %s\n' "$f" "$m" >&2
  done
  return 1
}

if [ $# -gt 0 ]; then
  for f in "$@"; do
    [ -f "$f" ] || { warn "Keine Datei: $f"; continue; }
    if printf '%s\n' "$f" | grep -E "$BADNAMES" | grep -vqE "$BADNAMES_OK"; then
      found=1; printf '%sGEHEIMNIS-DATEI?%s %s\n' "$C_RED" "$C_OFF" "$f" >&2
    fi
    awk -v f="$f" '{print f "\t" $0}' "$f" | scan_stream "in $f" || found=1
  done
else
  commits=$(git rev-list HEAD --not --remotes=origin 2>/dev/null)
  if [ -n "$commits" ]; then
    names=$(git log --format= --name-only --diff-filter=A HEAD --not --remotes=origin | sort -u | grep -E "$BADNAMES" | grep -vE "$BADNAMES_OK" || true)
    if [ -n "$names" ]; then
      found=1
      printf '%sGEHEIMNIS-DATEI in ausgehenden Commits:%s\n' "$C_RED" "$C_OFF" >&2
      printf '%s\n' "$names" | sed 's/^/    /' >&2
    fi
    git log -p --no-color --no-ext-diff --format= HEAD --not --remotes=origin \
      | awk '/^\+\+\+ b\//{f=substr($0,7); next} /^\+\+\+ /{next} /^\+/{print f "\t" substr($0,2)}' \
      | scan_stream "in ausgehenden Commits" || found=1
  fi
fi

if [ "$found" -ne 0 ]; then
  note "Nichts pushen. Geheimnis entfernen (bei ausgehenden Commits: Commit korrigieren, nicht force-pushen), Schlüssel als kompromittiert behandeln, wenn er schon draußen war."
  exit 1
fi
exit 0
