#!/usr/bin/env bash
# Eingabe -> Anforderungen -> Demo in einem Schritt (R3, ohne Handgriffe):
#   demo/run <fall-ordner> [weitere Optionen für certreq run]
# Danach demo/dist/index.html im Browser öffnen (kein Server, kein Node nötig).
set -euo pipefail
cd "$(dirname "$0")/.."
[ $# -ge 1 ] || { echo "Nutzung: demo/run <fall-ordner> [certreq-run-optionen]" >&2; exit 2; }
case_dir="${1%/}"; shift
out="out/$(basename "$case_dir").json"
.venv/bin/python -m certreq run "$case_dir" --out "$out" "$@"
.venv/bin/python demo/prepare.py "$out" --case "$case_dir"
