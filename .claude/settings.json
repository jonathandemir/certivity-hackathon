{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/session-start",
            "timeout": 60,
            "statusMessage": "Lade Teamstand (STATUS + LOG)"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/stop-check --hook",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(scripts/session-start)",
      "Bash(scripts/session-start *)",
      "Bash(scripts/stop-check)",
      "Bash(scripts/log *)",
      "Bash(scripts/sync)",
      "Bash(scripts/pull-first)",
      "Bash(scripts/claim *)",
      "Bash(scripts/main-wt)",
      "Bash(scripts/secret-scan)",
      "Bash(scripts/secret-scan *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)"
    ]
  }
}
